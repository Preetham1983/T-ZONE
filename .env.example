# ── Server & Docker Config ────────────────────────────────────────────────────
WEB_PORT=3100
HOST_API_PORT=8088
API_PORT=8000
MSGRAPH_CALLBACK_PORT=8484
DATA_DIR=./data
MSGRAPH_HOME=./data

# ── LLM Provider Selection ────────────────────────────────────────────────────
# dial | copilot
LLM_PROVIDER=dial
# agent_sdk | claude_sdk | normal
SS_AGENT_LLM_MODE=agent_sdk

# ── Profile A: GitHub Copilot (LLM_PROVIDER=copilot) ──────────────────────────
GITHUB_PAT=
COPILOT_SDK_PAT=
COPILOT_MODEL=gpt-4.1
COPILOT_TRANSPORT=auto

# ── Profile B: EPAM DIAL / Azure OpenAI (LLM_PROVIDER=dial) ───────────────────
EPAM_DIAL_API_KEY=your-epam-dial-api-key
KADB_EPAM_DIAL_API_KEY=your-epam-dial-api-key
AZURE_ENDPOINT=https://ai-proxy.lab.epam.com
API_VERSION=2024-02-01
CHAT_MODEL_NAME=gpt-4.1-mini-2025-04-14
